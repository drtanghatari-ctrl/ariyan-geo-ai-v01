<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ariyan_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ariyan_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/textSyntheticNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/synthetic_notice"
            android:textColor="@color/ariyan_warn"
            android:textSize="12sp"
            android:paddingBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordinates (lat, lon)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="51.1789000, -1.8262000" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUseLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Use current location" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_radius">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="500" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_grid">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="96" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/run_investigation"
            app:backgroundTint="@color/ariyan_accent" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchRealDem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/use_real_dem"
            android:textColor="@color/ariyan_text_primary" />

        <TextView
            android:id="@+id/textRealDemNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/real_dem_notice"
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="11sp"
            android:paddingTop="2dp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_api_key"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDemType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_demtype"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDemType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SRTMGL1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNdviCorrelation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Include NDVI correlation (adds a second evidence source)"
            android:textColor="@color/ariyan_text_primary" />

        <TextView
            android:id="@+id/textNdviNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="By default NDVI is synthetic (Sentinel-2 raster imagery requires rasterio, which cannot be built for Android yet). Turn on &quot;Use real NDVI&quot; below for a real, targeted per-candidate Sentinel-2 vegetation check instead."
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="11sp"
            android:paddingTop="2dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchRealNdvi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Use real NDVI (Copernicus Sentinel-2)"
            android:textColor="@color/ariyan_text_primary" />

        <TextView
            android:id="@+id/textRealNdviNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Real NDVI is a TARGETED check at each DEM candidate's own location (small core area vs. a larger surrounding halo), not an independent full-area scan. A CORROBORATED result means real DEM plus a real, independently-measured vegetation-stress signal at that point. Requires your own free Copernicus Data Space Ecosystem OAuth2 client ID + secret, held only in memory for this session — never written to disk."
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="11sp"
            android:paddingTop="2dp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNdviClientId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Copernicus OAuth2 client ID"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNdviClientId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNdviClientSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Copernicus OAuth2 client secret"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNdviClientSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/ariyan_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="12sp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
