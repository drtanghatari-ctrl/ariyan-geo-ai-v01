<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Real shared-storage access for offline country data (this session's
         redesign): survives an app uninstall/reinstall, unlike app-private
         storage. WRITE/READ_EXTERNAL_STORAGE cover Android 9 and below,
         where scoped storage doesn't apply at all. MANAGE_EXTERNAL_STORAGE
         covers Android 11+ ("All files access"), the modern equivalent,
         requested via a one-time settings toggle (Settings.
         ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION, see
         ExternalStorageAccess.kt). tools:ignore="ScopedStorage" silences
         the lint warning Android Studio would otherwise raise for this
         permission, a deliberate, justified choice here, not an
         oversight (this app is sideloaded, never distributed via Google
         Play, so Play's policy restrictions on this permission don't apply). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Foreground-service redesign (2026-09-04) -- the offline download
         now runs in OfflineDownloadService.kt, not directly inside
         OfflineDataActivity's own coroutine, so a real on-device run
         survives the screen locking / the device going idle for hours
         (Doze/App Standby otherwise cuts a plain background process's
         network access entirely -- see that file's class doc for the
         real on-device symptom this fixes: NDVI went 0/76, even with
         offline_data_manager.py's own retry-with-backoff already in
         place). FOREGROUND_SERVICE_DATA_SYNC is the Android 14+
         (API 34+) type declaration required alongside the service's own
         android:foregroundServiceType="dataSync" below. POST_NOTIFICATIONS
         is Android 13+ (API 33+), needed to actually show the progress
         notification that keeps this exempt from being treated as an
         idle background process; WAKE_LOCK backs the partial wake lock
         the service holds for its own run. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AriyanApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AriyanGeoAi"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true">