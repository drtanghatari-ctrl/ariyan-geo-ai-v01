<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ariyan_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ariyan_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOfflineData"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="8dp"
            android:text="@string/open_offline_data"
            android:textColor="@color/ariyan_accent" />

        <TextView
            android:id="@+id/textRealDataNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/real_data_notice"
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="12sp"
            android:paddingBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Coordinates (lat, lon)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputCoords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="51.1789000, -1.8262000" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUseLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Use current location" />
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_radius">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:text="500" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_grid">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="96" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRun"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/run_investigation"
            app:backgroundTint="@color/ariyan_accent" />

        <TextView
            android:id="@+id/textRealDemNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/real_dem_notice"
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="11sp"
            android:paddingTop="2dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/hint_api_key">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDemType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_demtype">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDemType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SRTMGL1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchNdviCorrelation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Include NDVI correlation (adds a second evidence source)"
            android:textColor="@color/ariyan_text_primary" />

        <TextView
            android:id="@+id/textNdviNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ndvi_notice"
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="11sp"
            android:paddingTop="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textRealNdviNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/real_ndvi_notice"
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="11sp"
            android:paddingTop="2dp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNdviClientId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Copernicus OAuth client ID"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNdviClientId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNdviClientSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Copernicus OAuth client secret"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputNdviClientSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchGpr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Attach GPR field pick (adds a third, site-anchored evidence source)"
            android:textColor="@color/ariyan_text_primary" />

        <TextView
            android:id="@+id/textGprNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Requires a real two-way travel time read off an actual radargram (no GPR device is parsed automatically yet). Only attaches when &quot;Include NDVI correlation&quot; above is also enabled, since only that investigation path currently supports a third evidence source."
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="11sp"
            android:paddingTop="2dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutGprSoilPreset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Soil preset key (air, fresh_water, dry_sand, saturated_sand, dry_clay, saturated_clay, silt_dry, loam_dry, limestone, granite, concrete_dry, ice)"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputGprSoilPreset"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:text="loam_dry" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutGprTwoWayTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Two-way travel time (ns), as read off the radargram"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputGprTwoWayTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutGprDeviceNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="GPR device / method note (optional)"
            android:visibility="gone">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputGprDeviceNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textRealGprNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Depth is converted from the travel time using a published reference soil velocity range (Daniels; Conyers) -- an approximation, not a site-calibrated measurement. Reported as a depth estimate with an explicit min/max range, never a single precise number. This is a manual field pick (entry_method=manual); no specific GPR device export is parsed automatically yet."
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="11sp"
            android:paddingTop="2dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textConfidence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/ariyan_accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/ariyan_text_secondary"
            android:textSize="12sp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>
