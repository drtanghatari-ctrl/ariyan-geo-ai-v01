<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AriyanGeoAi" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ariyan_accent</item>
        <item name="colorPrimaryDark">@color/ariyan_bg</item>
        <item name="colorAccent">@color/ariyan_accent</item>
        <item name="android:windowBackground">@color/ariyan_bg</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/ariyan_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/ariyan_bg</item>
        <!-- Android 15: the app targets SDK 35, so screens were drawn edge to
             edge, under the status bar and the navigation buttons. This keeps
             every screen between the two bars. Older Android ignores it. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>
</resources>